---
import siteData from '../content/settings/site.json';
import footerData from '../content/footer/footer.json';
const { ngo_name } = siteData;
const columns = footerData.footer || [];

// Calculate layout grids dynamically based on total list entries (up to 4)
const gridColumnsClass = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
}[columns.length] || "grid-cols-1 md:grid-cols-4";
---
<footer class="bg-slate-900 text-slate-400 pt-16 pb-8 border-t-4 border-[rgb(var(--color-primary))]">
  <div class={`max-w-7xl mx-auto px-4 grid ${gridColumnsClass} gap-12 mb-12`}>
    {columns.map((col) => (
      <div>
        <h4 class="text-white font-bold text-lg mb-4 tracking-wide">{col.title}</h4>
        <ul class="space-y-3 text-sm">
          {col.links.map((item) => (
            <li>
              {item.url ? (
                /* 🎯 Aligned Hover: Changes text to primary brand color smoothly without an underline */
                <a 
                  href={item.url} 
                  class="hover:text-[rgb(var(--color-primary))] transition-colors duration-150 no-underline"
                >
                  {item.label}
                </a>
              ) : (
                <span class="block leading-relaxed">{item.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  
  <div class="max-w-7xl mx-auto px-4 pt-8 border-t border-slate-800 text-center text-xs tracking-wider">
    <p>&copy; {new Date().getFullYear()} {ngo_name} Change Maker Trust. All Rights Reserved.</p>
  </div>
</footer>