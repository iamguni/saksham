---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import siteData from '../content/settings/site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteData.tagline } = Astro.props;
// Fallback to custom vector signature if favicon_url field is missing
const activeFavicon = siteData.favicon_url || "/favicon.svg";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={activeFavicon} />
    <meta name="description" content={description} />
    <title>{title} | {siteData.ngo_name} Trust</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
  </body>
</html>