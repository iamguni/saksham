---
import siteData from '../content/settings/site.json';
---
<section class="max-w-5xl mx-auto px-4 py-20 grid grid-cols-1 md:grid-cols-2 gap-12">
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
    <h3 class="text-2xl font-black text-[rgb(var(--color-primary))] mb-4">Our Mission</h3>
    <p class="text-slate-600 leading-relaxed">{siteData.mission}</p>
  </div>
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
    <h3 class="text-2xl font-black text-[rgb(var(--color-accent))] mb-4">Our Vision</h3>
    <p class="text-slate-600 leading-relaxed">{siteData.vision}</p>
  </div>
</section>
