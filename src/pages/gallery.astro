---
import MainLayout from '../layouts/MainLayout.astro';

// 1. Vite's native layout file-system globs aggregate all local content items dynamically
const projectFiles = import.meta.glob('../content/projects/*.json', { eager: true });
const activityFiles = import.meta.glob('../content/activities/*.json', { eager: true });

// ⚡ 2. Index available assets inside both target image directories eagerly
const projectImagesMap = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/*.{jpeg,jpg,png,gif,webp}', { eager: true });
const activityImagesMap = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/activities/*.{jpeg,jpg,png,gif,webp}', { eager: true });

// 3. Extract, sanitize, and build out structural collection mapping layers
const projectImages = Object.values(projectFiles).map((file: any) => {
  const rawData = file.default || file;
  const imagePath = rawData.image || '';
  
  const resolvedSrc = imagePath in projectImagesMap 
    ? projectImagesMap[imagePath].default.src 
    : imagePath;

  return {
    src: resolvedSrc,
    title: rawData.title || 'Project Initiative',
    type: 'Project Initiative',
    filterTag: 'projects'
  };
});

const activityImages = Object.values(activityFiles).map((file: any) => {
  const rawData = file.default || file;
  const imagePath = rawData.image || '';
  
  const resolvedSrc = imagePath in activityImagesMap 
    ? activityImagesMap[imagePath].default.src 
    : imagePath;

  return {
    src: resolvedSrc,
    title: rawData.title || 'Activity Event',
    type: 'Activity Event',
    filterTag: 'activities'
  };
});

// 4. Flatten arrays into a single master pool
const galleryItems = [...projectImages, ...activityImages].filter(item => item.src && item.src.trim() !== "");

const hasProjects = galleryItems.some(item => item.filterTag === 'projects');
const hasActivities = galleryItems.some(item => item.filterTag === 'activities');
---

<MainLayout title="Visual Gallery">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h1 class="text-4xl font-black text-slate-900 tracking-tight">Impact & Activity Gallery</h1>
      <div class="w-12 h-1 bg-[rgb(var(--color-primary))] mx-auto mt-4 rounded-full"></div>
      <p class="text-slate-500 text-sm mt-3">A visual chronicle of our grassroots transformations and ongoing field campaigns.</p>
    </div>

    {galleryItems.length > 0 ? (
      <>
        {/* Dynamic Interactive Filter Selection Bar */}
        <div class="flex justify-center items-center space-x-3 mb-12 flex-wrap gap-y-2">
          <button 
            class="gallery-filter-btn px-6 py-2.5 text-xs font-bold uppercase tracking-wider rounded-full bg-[rgb(var(--color-primary))] text-white transition-all shadow-sm focus:outline-none" 
            data-target="all"
          >
            All Media ({galleryItems.length})
          </button>
          
          {hasProjects && (
            <button 
              class="gallery-filter-btn px-6 py-2.5 text-xs font-bold uppercase tracking-wider rounded-full bg-white text-slate-600 border border-slate-200/80 hover:bg-slate-50 transition-all focus:outline-none" 
              data-target="projects"
            >
              Projects ({projectImages.length})
            </button>
          )}
          
          {hasActivities && (
            <button 
              class="gallery-filter-btn px-6 py-2.5 text-xs font-bold uppercase tracking-wider rounded-full bg-white text-slate-600 border border-slate-200/80 hover:bg-slate-50 transition-all focus:outline-none" 
              data-target="activities"
            >
              Activities ({activityImages.length})
            </button>
          )}
        </div>

        {/* 📸 Unified Interactive Grid Display Matrix */}
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6" id="gallery-grid">
          {galleryItems.map((item) => (
            <div 
              class="gallery-card group relative rounded-xl overflow-hidden shadow-md h-64 bg-slate-100 border border-slate-100 transition-all duration-300"
              data-category={item.filterTag}
            >
              <img 
                src={item.src} 
                alt={item.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                <span class="text-xs font-bold tracking-widest text-[rgb(var(--color-secondary))] uppercase mb-1">
                  {item.type}
                </span>
                <h3 class="text-white font-bold text-lg leading-snug truncate">
                  {item.title}
                </h3>
              </div>
            </div>
          ))}
        </div>

        {/* ⚡ Dynamic Client-Side Pagination Layout Footer Controls */}
        <div class="flex justify-center items-center mt-12 space-x-2" id="pagination-controls">
          <!-- Dynamic number buttons and next/prev indicators go here via JavaScript -->
        </div>
      </>
    ) : (
      <div class="text-center py-20 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
        <p class="text-slate-500 text-base">No media assets or upload items found across your current projects or activities.</p>
      </div>
    )}
  </div>
</MainLayout>

<!-- Client-Side Runtime JavaScript for Filtration and Smooth Pagination -->
<script>
  const filterButtons = document.querySelectorAll('.gallery-filter-btn');
  const galleryCards = Array.from(document.querySelectorAll('.gallery-card')) as HTMLElement[];
  const paginationControls = document.getElementById('pagination-controls');

  // --- PAGINATION SETTINGS MATRIX ---
  const ITEMS_PER_PAGE = 6; // Adjust this scale value number to balance page size capacity
  let currentPage = 1;
  let activeCategory = 'all';

  function renderGalleryStructure() {
    // 1. Identify which items pass the category filter flag parameter
    const filteredCards = galleryCards.filter(card => {
      const category = card.getAttribute('data-category');
      return activeCategory === 'all' || category === activeCategory;
    });

    const totalPages = Math.ceil(filteredCards.length / ITEMS_PER_PAGE) || 1;

    // Boundary Protection: Clamp current page selections within maximum ranges
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    // 2. Hide or show grid elements depending on category and current active page window limits
    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = startIndex + ITEMS_PER_PAGE;

    galleryCards.forEach(card => card.classList.add('hidden-card'));

    filteredCards.forEach((card, index) => {
      if (index >= startIndex && index < endIndex) {
        card.classList.remove('hidden-card');
      }
    });

    // 3. Rebuild the pagination interaction control button tray layout
    if (paginationControls) {
      paginationControls.innerHTML = '';

      if (totalPages > 1) {
        // Prev Button Control Setup
        const prevBtn = document.createElement('button');
        prevBtn.innerHTML = '&larr; Previous';
        prevBtn.className = `px-4 py-2 text-xs font-bold border border-slate-200 rounded-lg text-slate-600 transition-all focus:outline-none ${currentPage === 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-50'}`;
        if (currentPage > 1) {
          prevBtn.addEventListener('click', () => {
            currentPage--;
            renderGalleryStructure();
            window.scrollTo({ top: (document.getElementById('gallery-grid')?.offsetTop || 300) - 100, behavior: 'smooth' });
          });
        }
        paginationControls.appendChild(prevBtn);

        // Numeric Page Selection Nodes Generation Row
        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.innerText = i.toString();
          pageBtn.className = `w-9 h-9 text-xs font-bold rounded-lg border transition-all focus:outline-none ${i === currentPage ? 'bg-[rgb(var(--color-primary))] border-[rgb(var(--color-primary))] text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}`;
          pageBtn.addEventListener('click', () => {
            currentPage = i;
            renderGalleryStructure();
            window.scrollTo({ top: (document.getElementById('gallery-grid')?.offsetTop || 300) - 100, behavior: 'smooth' });
          });
          paginationControls.appendChild(pageBtn);
        }

        // Next Button Control Setup
        const nextBtn = document.createElement('button');
        nextBtn.innerHTML = 'Next &rarr;';
        nextBtn.className = `px-4 py-2 text-xs font-bold border border-slate-200 rounded-lg text-slate-600 transition-all focus:outline-none ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-50'}`;
        if (currentPage < totalPages) {
          nextBtn.addEventListener('click', () => {
            currentPage++;
            renderGalleryStructure();
            window.scrollTo({ top: (document.getElementById('gallery-grid')?.offsetTop || 300) - 100, behavior: 'smooth' });
          });
        }
        paginationControls.appendChild(nextBtn);
      }
    }
  }

  // Handle category toolbar click event setups
  filterButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget as HTMLButtonElement;
      activeCategory = targetBtn.getAttribute('data-target') || 'all';
      currentPage = 1; // Always reset pagination back to page 1 on filter shifts

      // Revert styles to baseline definitions across non-active items
      filterButtons.forEach(btn => {
        btn.className = "gallery-filter-btn px-6 py-2.5 text-xs font-bold uppercase tracking-wider rounded-full bg-white text-slate-600 border border-slate-200/80 hover:bg-slate-50 transition-all focus:outline-none";
      });

      // Highlight target visual activation parameters
      targetBtn.className = "gallery-filter-btn px-6 py-2.5 text-xs font-bold uppercase tracking-wider rounded-full bg-[rgb(var(--color-primary))] text-white transition-all shadow-sm focus:outline-none";

      renderGalleryStructure();
    });
  });

  // Launch initial component layout parsing loop 
  renderGalleryStructure();
</script>

<style>
  /* Clean visibility fallback utility to hide items out of scope without losing grid styling constraints */
  .hidden-card {
    display: none !important;
  }
</style>