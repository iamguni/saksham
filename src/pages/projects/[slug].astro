---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

// Astro now automatically knows the exact type constraints of your route params!
export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project: project.data }, // Extract the structured JSON data block safely
  }));
}

const { project } = Astro.props;

// ⚡ 1. Dynamically index all available images inside the projects asset folder eagerly
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/*.{jpeg,jpg,png,gif,webp}', { eager: true });

// ⚡ 2. Extract the string path from JSON and check the glob index map
const targetImagePath = project.image || '';
const isAssetDiscovered = targetImagePath in images;
---
<MainLayout title={project.title}>
  <article class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-5xl font-black mb-6">{project.title}</h1>
    
    <div class="rounded-2xl w-full overflow-hidden mb-8 max-h-[450px] bg-slate-100">
      {isAssetDiscovered ? (
        /* ⚡ 3. Render dynamic optimized source output if matched safely without calling () */
        <img 
          src={images[targetImagePath].default.src} 
          alt={project.title} 
          class="w-full h-full object-cover" 
        />
      ) : (
        /* Fallback directly to the raw string path value if no match is found */
        <img 
          src={targetImagePath} 
          alt={project.title} 
          class="w-full h-full object-cover" 
        />
      )}
    </div>

    <div class="text-slate-800 text-base space-y-6 whitespace-pre-line">
      {project.description}
    </div>
  </article>
</MainLayout>